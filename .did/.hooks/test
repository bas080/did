#!/bin/sh
if ! CARGO_TEST_OUT=$(cargo test 2>&1); then
    echo "$CARGO_TEST_OUT" >&2
    exit 1
fi

# Check for issues in implement that still contain questions for @bas080
STILL_REFINING=""
for f in $(find .did/implement -type f ! -name ".*" ! -path "*/.hooks/*" 2>/dev/null); do
    if grep -q "@bas080" "$f"; then
        STILL_REFINING="$STILL_REFINING
  - $f"
    fi
done

if [ -n "$STILL_REFINING" ]; then
    echo "error: issues in .did/implement/ still contain questions for @bas080 (move back to refine):" >&2
    echo "$STILL_REFINING" >&2
    exit 1
fi

UNTAGGED_REFINE=""
for f in $(find .did/refine -type f ! -name ".*" ! -path "*/.hooks/*" 2>/dev/null); do
    if ! grep -q "@bas080" "$f"; then
        UNTAGGED_REFINE="$UNTAGGED_REFINE
  - $f"
    fi
done

if [ -n "$UNTAGGED_REFINE" ]; then
    echo "error: issue files in .did/refine/ missing @bas080 tag:" >&2
    echo "$UNTAGGED_REFINE" >&2
    exit 1
fi
