#!/bin/sh
if ! CARGO_TEST_OUT=$(cargo test 2>&1); then
    echo "$CARGO_TEST_OUT" >&2
    exit 1
fi

UNRESOLVED_IMPLEMENT=$(find .did/implement -type f ! -name ".*" ! -path "*/.hooks/*" 2>/dev/null)
if [ -n "$UNRESOLVED_IMPLEMENT" ]; then
    echo "error: unresolved tasks remain in .did/implement/:" >&2
    echo "$UNRESOLVED_IMPLEMENT" | sed 's/^/  - /' >&2
    exit 1
fi

UNTAGGED_REFINE=""
for f in $(find .did/refine -type f ! -name ".*" ! -path "*/.hooks/*" 2>/dev/null); do
    if ! grep -q "@bas080" "$f"; then
        UNTAGGED_REFINE="$UNTAGGED_REFINE
  - $f"
    fi
done

if [ -n "$UNTAGGED_REFINE" ]; then
    echo "error: issue files in .did/refine/ missing @bas080 tag:" >&2
    echo "$UNTAGGED_REFINE" >&2
    exit 1
fi
