#!/bin/sh
# .did/.hooks/test-env-vars
# Checks if all environment variables used in src/ are documented in README.md

echo "Checking environment variable documentation..."

# Extract all DID_ variables from src/
VARS=$(grep -r 'env::var("' src/ | sed -E 's/.*"([^"]+)".*/\1/' | grep '^DID_' | sort -u)

MISSING=0
for var in $VARS; do
    if ! grep -q "$var" README.md; then
        echo "❌ Missing documentation for environment variable: $var"
        MISSING=$((MISSING + 1))
    fi
done

if [ $MISSING -eq 0 ]; then
    echo "✅ All environment variables are documented in README.md"
    exit 0
else
    echo "❌ $MISSING environment variable(s) are missing from README.md"
    exit 1
fi
