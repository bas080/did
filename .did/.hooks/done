#!/bin/sh
if command -v did >/dev/null 2>&1; then
    did test || exit 1
else
    cargo run -- test || exit 1
fi

# ------------------------------------------------------------------------------
# ENV VAR DOCUMENTATION CHECK
# ------------------------------------------------------------------------------
VARS=$(grep -r 'env::var("' src/ | sed -E 's/.*"([^"]+)".*/\1/' | grep '^DID_' | sort -u)
MISSING=0
for var in $VARS; do
    if ! grep -q "$var" README.md; then
        echo "❌ Missing documentation for environment variable: $var"
        MISSING=$((MISSING + 1))
    fi
done

if [ $MISSING -ne 0 ]; then
    echo "❌ $MISSING environment variable(s) are missing from README.md"
    exit 1
fi
echo "✅ All environment variables are documented in README.md"
# ------------------------------------------------------------------------------

echo "# Task Completion Guidelines"
echo ""
echo "[TASK COMPLETION CHECKLIST]"
echo "Before completing a task, confirm that:"
echo "1. All functional requirements are 100% satisfied with zero open questions or remaining work."
echo "2. Automated unit and integration tests are written and passing (cargo test)."
echo "3. Strict compiler linting passes without warnings (cargo clippy -- -D warnings)."
echo "4. Required test coverage thresholds are met (cargo llvm-cov)."
echo ""
echo "[RULES]"
echo "1. If you relied on non-did CLI commands (e.g. rm, ls, cat, find, mkdir) to interact with .did,"
echo "   you MUST create a refined issue under .did/refine/ proposing a missing did subcommand or flag."
echo "2. If code or configuration duplication is detected, you MUST create a refined issue under .did/refine/ proposing refactoring."
